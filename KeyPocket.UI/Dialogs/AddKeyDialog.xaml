<ContentDialog
    x:Class="KeyPocket.UI.Dialogs.AddKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Add API Key"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="400">
        <TextBox x:Name="KeyNameBox" Header="Name" PlaceholderText="e.g. Personal Key" />
        <PasswordBox x:Name="KeySecretBox" Header="API Key" PlaceholderText="sk-..." />
    </StackPanel>
</ContentDialog>

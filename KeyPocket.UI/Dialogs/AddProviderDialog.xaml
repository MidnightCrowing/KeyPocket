<ContentDialog
    DefaultButton="Primary"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    Title="Add Service Provider"
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Dialogs.AddProviderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16" Width="400">
        <TextBox Header="Name" x:Name="NameBox" />

        <ComboBox
            Header="Provider Type"
            HorizontalAlignment="Stretch"
            SelectedIndex="0"
            x:Name="TypeBox">
            <ComboBoxItem Content="OpenAI Compatible" />
            <ComboBoxItem Content="Anthropic" />
            <ComboBoxItem Content="Custom" />
        </ComboBox>

        <TextBox
            Header="Base URL (Optional)"
            PlaceholderText="https://api.openai.com/v1"
            x:Name="UrlBox" />

        <TextBox Header="Description (Optional)" x:Name="DescBox" />
    </StackPanel>
</ContentDialog>

<UserControl
    x:Class="KeyPocket.UI.Controls.HomeProviderCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ProviderViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:NegatedBoolToVisibilityConverter x:Key="NegatedBoolToVisConverter" />
            <ThemeShadow x:Name="SharedShadow" />
            <Style TargetType="Button" x:Key="ModelTagButtonStyle">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                x:Name="RootGrid">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    x:Name="ContentPresenter" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorInverseBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorInverseBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        AllowDrop="True"
        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CanDrag="True"
        CornerRadius="8"
        DragOver="OnCardDragOver"
        DragStarting="OnCardDragStarting"
        Drop="OnCardDrop"
        Padding="16"
        Shadow="{StaticResource SharedShadow}"
        Tapped="OnProviderTapped"
        Translation="0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="20"
                    Glyph="{x:Bind Provider.Icon}"
                    Visibility="{x:Bind Provider.IsCustomIcon, Converter={StaticResource NegatedBoolToVisConverter}, Mode=OneWay}" />
                <Image
                    Height="20"
                    Source="{x:Bind Provider.CustomIconSource, Mode=OneWay}"
                    Visibility="{x:Bind Provider.IsCustomIcon, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                    Width="20" />
            </Grid>
            <TextBlock
                Grid.Column="1"
                IsTextSelectionEnabled="False"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Provider.Name}"
                VerticalAlignment="Center" />
            <Ellipse
                Fill="{x:Bind Provider.StatusColor}"
                Grid.Column="2"
                Height="8"
                Width="8" />
        </Grid>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Grid.Row="1"
            IsTextSelectionEnabled="False"
            Margin="0,8,0,0"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind Provider.Description}"
            TextTrimming="CharacterEllipsis"
            Visibility="{x:Bind Provider.HasDescription, Converter={StaticResource BoolToVisConverter}}" />

        <StackPanel
            Grid.Row="2"
            Margin="0,8,0,0"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind Provider.HasBaseUrl, Converter={StaticResource BoolToVisConverter}}">
            <Border CornerRadius="4" Padding="6,2">
                <Border.Background>
                    <SolidColorBrush Color="{x:Bind Provider.ApiModeColor}" Opacity="0.15" />
                </Border.Background>
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{x:Bind Provider.Type}">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="{x:Bind Provider.ApiModeColor}" />
                    </TextBlock.Foreground>
                </TextBlock>
            </Border>

            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                MaxWidth="180"
                Text="{x:Bind Provider.BaseUrl}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />

            <controls:CopyButton
                Click="OnCopyBaseUrlClicked"
                Content="&#xE8C8;"
                FontSize="10"
                Padding="4"
                Tag="{x:Bind Provider.BaseUrl}"
                ToolTipService.ToolTip="Copy Base URL" />
        </StackPanel>

        <ItemsControl
            Grid.Row="3"
            IsHitTestVisible="True"
            ItemsSource="{x:Bind Provider.Models}"
            Margin="0,16,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ctk:WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelItem">
                    <Button
                        Click="OnCopyModelIdClicked"
                        Content="{x:Bind Name}"
                        Margin="0,0,8,8"
                        Style="{StaticResource ModelTagButtonStyle}"
                        Tag="{x:Bind Id}"
                        ToolTipService.ToolTip="{x:Bind Id}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl
            Grid.Row="4"
            IsHitTestVisible="True"
            ItemsSource="{x:Bind Provider.Keys}"
            Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyItem">
                    <Button
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Click="OnCopyKeyClicked"
                        CornerRadius="4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,0,0,8"
                        Padding="8,6"
                        Tag="{x:Bind FullKey}"
                        ToolTipService.ToolTip="Click to copy full key">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                CornerRadius="3"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Margin="0,0,8,0"
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind HasTag, Converter={StaticResource BoolToVisConverter}}">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind TagColor}" Opacity="0.15" />
                                </Border.Background>
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Tag}">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{x:Bind TagColor}" />
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>

                            <TextBlock
                                FontFamily="Consolas, Courier New, Monospace"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="1"
                                Text="{x:Bind KeyStart}"
                                VerticalAlignment="Center" />

                            <TextBlock
                                CharacterSpacing="200"
                                FontFamily="Consolas, Courier New, Monospace"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Margin="4,4,4,0"
                                MaxLines="1"
                                Text="* * * * * * * * * * * * * * * * * * * *"
                                TextAlignment="Center"
                                TextTrimming="Clip"
                                VerticalAlignment="Center" />

                            <TextBlock
                                FontFamily="Consolas, Courier New, Monospace"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="3"
                                Text="{x:Bind KeyEnd}"
                                VerticalAlignment="Center" />

                            <controls:CopyButton
                                Click="OnCopyKeyClicked"
                                Content="&#xE8C8;"
                                Grid.Column="4"
                                Margin="8,0,0,0"
                                Tag="{x:Bind FullKey}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

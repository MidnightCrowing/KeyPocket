<?xml version="1.0" encoding="utf-8" ?>

<Window
    Title="KeyPocket"
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KeyPocket.UI.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            BackRequested="TitleBar_OnBackRequested"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_OnPaneToggleRequested"
            Title="{StaticResource AppTitleName}"
            x:Name="TitleBar"
            x:Uid="AppTitleBar">

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/KeyPocket.png" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <AutoSuggestBox
                    ItemsSource="{x:Bind SearchViewModel.SearchResults, Mode=OneWay}"
                    PlaceholderText="Search.."
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_OnQuerySubmitted"
                    SuggestionChosen="SearchBox_OnSuggestionChosen"
                    TextChanged="SearchBox_OnTextChanged"
                    VerticalAlignment="Center"
                    Width="360"
                    x:Name="SearchBox"
                    x:Uid="Shell_SearchBox">

                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SearchResultItem">
                            <Grid Padding="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Icon (Glyph or Image)  -->
                                <Grid
                                    Height="16"
                                    Margin="0,0,12,0"
                                    Width="16">
                                    <!--  FontIcon for Glyph  -->
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="{x:Bind Icon}"
                                        Visibility="{x:Bind IsGlyphIcon}" />

                                    <!--  BitmapIcon for Custom Icon  -->
                                    <BitmapIcon
                                        ShowAsMonochrome="False"
                                        UriSource="{x:Bind IconPath}"
                                        Visibility="{x:Bind IsImageIcon}" />
                                </Grid>

                                <!--  Title & Description  -->
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}" />
                                </StackPanel>

                                <!--  crash.log 特殊图标  -->
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE8A7;"
                                    Grid.Column="2"
                                    Visibility="{x:Bind IsSystemFile}" />
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            AlwaysShowHeader="False"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            ItemInvoked="NavigationView_ItemInvoked"
            SelectionChanged="NavigationView_SelectionChanged"
            x:Name="NavView">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Home"
                    Tag="HomePage"
                    x:Name="HomePage"
                    x:Uid="Shell_Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Models"
                    Tag="ModelsPage"
                    x:Name="ModelsPageItem"
                    x:Uid="Shell_Models">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF158;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="Keys"
                    Tag="KeysPage"
                    x:Name="KeysPageItem"
                    x:Uid="Shell_Keys">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader
                    Content="Providers"
                    Tag="ProvidersHeader"
                    x:Uid="Shell_Providers" />

                <NavigationViewItem
                    Content="Add Provider"
                    SelectsOnInvoked="False"
                    Tag="AddProvider"
                    x:Name="AddProviderItem"
                    x:Uid="Shell_AddProvider">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE710;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
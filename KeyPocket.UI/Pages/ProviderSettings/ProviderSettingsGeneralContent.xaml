<UserControl
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.ProviderSettings.ProviderSettingsGeneralContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <StackPanel
        HorizontalAlignment="Stretch"
        MaxWidth="800"
        Spacing="24">
        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Name"
                x:Uid="ProviderSettings_Name" />
            <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Icon"
                x:Uid="ProviderSettings_Icon" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Presets" x:Uid="ProviderSettings_Presets">
                    <Button.Flyout>
                        <Flyout Placement="Bottom" x:Name="DefaultIconFlyout">
                            <GridView
                                HorizontalAlignment="Center"
                                IsItemClickEnabled="True"
                                ItemClick="OnDefaultIconItemClick"
                                ItemsSource="{x:Bind ViewModel.DefaultIcons, Mode=OneWay}"
                                MaxWidth="300"
                                SelectionMode="None">
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Margin" Value="0,6" />
                                        <Setter Property="Padding" Value="4" />
                                    </Style>
                                </GridView.ItemContainerStyle>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DefaultIconItem">
                                        <StackPanel
                                            Spacing="4"
                                            ToolTipService.ToolTip="{x:Bind Name}"
                                            Width="50">
                                            <Image
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                Source="{x:Bind Path}"
                                                Width="24" />
                                            <TextBlock
                                                FontSize="10"
                                                HorizontalAlignment="Center"
                                                MaxLines="1"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Click="OnChangeIconClicked"
                    Content="Browse..."
                    x:Uid="ProviderSettings_Browse" />

                <Button
                    Click="OnRemoveIconClicked"
                    Content="Remove Icon"
                    Style="{StaticResource DefaultButtonStyle}"
                    Visibility="{x:Bind ViewModel.HasCustomIcon, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                    x:Uid="ProviderSettings_RemoveIcon" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="API Mode"
                    x:Uid="ProviderSettings_ApiMode" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.ProviderTypes, Mode=OneWay}"
                    SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Base URL"
                    x:Uid="ProviderSettings_BaseUrl" />
                <TextBox
                    PlaceholderText="https://api.openai.com/v1"
                    Text="{x:Bind ViewModel.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    x:Uid="ProviderSettings_BaseUrlPlaceholder" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="The base URL of the API provider."
                    x:Uid="ProviderSettings_BaseUrlDesc" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Provider Currency"
                x:Uid="ProviderSettings_ProviderCurrency" />
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.AvailableCurrencies, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.ProviderCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="The currency used by this provider for billing."
                x:Uid="ProviderSettings_ProviderCurrencyDesc" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Description"
                x:Uid="ProviderSettings_Description" />
            <TextBox
                AcceptsReturn="True"
                Height="80"
                Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Button
            Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}"
            Content="Save Changes"
            HorizontalAlignment="Right"
            Style="{StaticResource AccentButtonStyle}"
            x:Uid="ProviderSettings_Save" />
    </StackPanel>
</UserControl>
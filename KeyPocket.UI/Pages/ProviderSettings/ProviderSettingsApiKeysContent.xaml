<sections:ProviderSettingsSectionBase
    x:Class="KeyPocket.UI.Pages.ProviderSettings.ProviderSettingsApiKeysContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:sections="using:KeyPocket.UI.Pages.ProviderSettings"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        HorizontalAlignment="Stretch"
        MaxWidth="800"
        Spacing="16">
        <ListView
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            ItemsSource="{x:Bind ViewModel.ApiKeys, Mode=OneWay}"
            ScrollViewer.VerticalScrollMode="Disabled"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyWrapper">
                    <Grid
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">

                        <!--  Read Only View  -->
                        <Grid Visibility="{x:Bind IsReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Left Side: Masked Key  -->
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind MaskedKey, Mode=OneWay}"
                                VerticalAlignment="Center" />

                            <!--  Right Side: Buttons  -->
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">

                                <!--  Tag Button / Input Area  -->
                                <Grid>
                                    <!--  Add Tag Icon Button (shown when no tag)  -->
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind StartEditTagCommand}"
                                        Padding="8"
                                        ToolTipService.ToolTip="Add Tag"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsTagDisplayVisible, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                        x:Uid="/ProviderSettings/AddTag">
                                        <FontIcon
                                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                                            FontSize="16"
                                            Glyph="&#xE8EC;" />
                                    </Button>

                                    <!--  Tag Text Button (shown when tag exists and not editing)  -->
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind StartEditTagCommand}"
                                        HorizontalContentAlignment="Left"
                                        Padding="0"
                                        ToolTipService.ToolTip="Click to edit tag"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsTagTextVisible, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                        x:Uid="/ProviderSettings/EditTag">
                                        <controls:KeyTag
                                            FontSize="12"
                                            TagCornerRadius="4"
                                            TagPadding="6,2"
                                            Text="{x:Bind Tag, Mode=OneWay}" />
                                    </Button>

                                    <!--  Tag Input (shown when editing)  -->
                                    <TextBox
                                        KeyDown="OnKeyTagKeyDown"
                                        PlaceholderText="Tag"
                                        Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsTagEditing, Converter={StaticResource BoolToVisConverter}, Mode=OneWay}"
                                        Width="80"
                                        x:Uid="Keys/Tag" />
                                </Grid>

                                <controls:CopyButton
                                    Click="OnCopyKeyClicked"
                                    Content="&#xE8C8;"
                                    Padding="8"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copy Key"
                                    x:Uid="Keys/CopyKey" />
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ToggleFavoriteCommand}"
                                    Padding="8"
                                    ToolTipService.ToolTip="Favorite"
                                    x:Uid="/ProviderSettings/Favorite">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Glyph="{x:Bind FavoriteIcon, Mode=OneWay}" />
                                </Button>
                                <Button
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind DeleteCommand}"
                                    Padding="8"
                                    ToolTipService.ToolTip="Delete"
                                    x:Uid="/ProviderSettings/Delete">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Edit View  -->
                        <Grid KeyDown="OnApiKeyEditKeyDown" Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PasswordBox
                                Password="{x:Bind NewKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Enter API Key (sk-...)"
                                x:Uid="/ProviderSettings/ApiKeyPlaceholder" />

                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Command="{x:Bind ConfirmAddCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Confirm"
                                    Style="{StaticResource AccentButtonStyle}"
                                    x:Uid="/ProviderSettings/Confirm" />
                                <Button
                                    Command="{x:Bind CancelAddCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="Cancel"
                                    x:Uid="/ProviderSettings/Cancel" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button
            Command="{x:Bind ViewModel.AddKeyCommand, Mode=OneWay}"
            Content="Add API Key"
            x:Uid="/ProviderSettings/AddApiKey" />
    </StackPanel>
</sections:ProviderSettingsSectionBase>

<UserControl
    x:Class="KeyPocket.UI.Pages.Models.ModelsFilterButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Pages/Models/ModelsPage.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DropDownButton ToolTipService.ToolTip="Filter">
        <DropDownButton.Content>
            <FontIcon FontSize="16" Glyph="&#xE71C;" />
        </DropDownButton.Content>
        <DropDownButton.Flyout>
            <Flyout Placement="Bottom">
                <StackPanel Spacing="16" Width="350">
                    <!--  Header + Reset Button  -->
                    <Grid>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Filters"
                            VerticalAlignment="Center"
                            x:Uid="/Models/Filter_Title" />
                        <Button
                            Click="ResetFilters_Click"
                            Content="Reset"
                            HorizontalAlignment="Right"
                            Style="{StaticResource TextBlockButtonStyle}"
                            x:Uid="/Models/Filter_Reset" />
                    </Grid>

                    <!--  Capability Section  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Capability"
                            x:Uid="/Models/Filter_Capability" />
                        <ctk:Segmented
                            ItemContainerStyle="{StaticResource CustomSegmentedItemStyle}"
                            SelectionMode="Multiple"
                            Style="{StaticResource ButtonSegmentedStyle}">
                            <ctk:SegmentedItem
                                Content="Text"
                                IsSelected="{x:Bind ViewModel.IsTextSelected, Mode=TwoWay}"
                                ToolTipService.ToolTip="Text/Chat models"
                                x:Uid="/Models/Segment_Text" />
                            <ctk:SegmentedItem
                                Content="File"
                                IsSelected="{x:Bind ViewModel.IsFileSelected, Mode=TwoWay}"
                                ToolTipService.ToolTip="File processing models"
                                x:Uid="/Models/Segment_File" />
                            <ctk:SegmentedItem
                                Content="Image"
                                IsSelected="{x:Bind ViewModel.IsImageSelected, Mode=TwoWay}"
                                ToolTipService.ToolTip="Image models"
                                x:Uid="/Models/Segment_Image" />
                            <ctk:SegmentedItem
                                Content="Audio"
                                IsSelected="{x:Bind ViewModel.IsAudioSelected, Mode=TwoWay}"
                                ToolTipService.ToolTip="Audio models"
                                x:Uid="/Models/Segment_Audio" />
                            <ctk:SegmentedItem
                                Content="Video"
                                IsSelected="{x:Bind ViewModel.IsVideoSelected, Mode=TwoWay}"
                                ToolTipService.ToolTip="Video models"
                                x:Uid="/Models/Segment_Video" />
                            <ctk:SegmentedItem
                                Content="Embeddings"
                                IsSelected="{x:Bind ViewModel.IsEmbeddingsSelected, Mode=TwoWay}"
                                ToolTipService.ToolTip="Embedding models"
                                x:Uid="/Models/Segment_Embeddings" />
                        </ctk:Segmented>
                    </StackPanel>

                    <!--  Price Range Section  -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Prompt Pricing"
                            x:Uid="/Models/Filter_Pricing" />

                        <ctk:RangeSelector
                            Maximum="6"
                            Minimum="0"
                            RangeEnd="{x:Bind ViewModel.MaxPriceIndex, Mode=TwoWay}"
                            RangeStart="{x:Bind ViewModel.MinPriceIndex, Mode=TwoWay}"
                            StepFrequency="1" />

                        <!--  Ticks  -->
                        <Grid Margin="0,-8,0,0" Padding="8,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="0"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="1" />
                            <Rectangle
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="1"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="1" />
                            <Rectangle
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="2"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="1" />
                            <Rectangle
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="3"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="1" />
                            <Rectangle
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="4"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="1" />
                            <Rectangle
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="5"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Width="1" />
                            <Rectangle
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="5"
                                Height="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="1" />
                        </Grid>

                        <!--  Tick Labels  -->
                        <Grid Margin="0,0,0,-4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  0: Free  -->
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Text="Free"
                                x:Uid="/Models/Filter_Price_Free" />

                            <!--  1: 0.1  -->
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.1" />
                            </TextBlock>

                            <!--  2: 0.2  -->
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.2" />
                            </TextBlock>

                            <!--  3: 0.5  -->
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.5" />
                            </TextBlock>

                            <!--  4: 1  -->
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="3"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="1" />
                            </TextBlock>

                            <!--  5: 5  -->
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="4"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Center">
                                <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="5" />
                            </TextBlock>

                            <!--  6: 10+  -->
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Grid.Column="5"
                                HorizontalAlignment="Right">
                                <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="10+" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!--  Favorites Filter  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Status"
                            x:Uid="/Models/Filter_Status" />
                        <CheckBox
                            Content="Show favorites only"
                            IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                            x:Uid="/Models/Filter_FavoritesOnly" />
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>

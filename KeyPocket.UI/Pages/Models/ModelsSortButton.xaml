<UserControl
    x:Class="KeyPocket.UI.Pages.Models.ModelsSortButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Pages/Models/ModelsPage.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DropDownButton ToolTipService.ToolTip="Sort" x:Uid="/Models/Toolbar_Sort">
        <DropDownButton.Content>
            <FontIcon FontSize="16" Glyph="&#xE8CB;" />
        </DropDownButton.Content>
        <DropDownButton.Flyout>
            <MenuFlyout Placement="Bottom">
                <RadioMenuFlyoutItem
                    Click="SortOption_Click"
                    GroupName="Sort"
                    IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NameAsc, Mode=OneWay}"
                    Tag="NameAsc"
                    Text="Name (A-Z)"
                    x:Uid="/Models/Sort_NameAsc" />
                <RadioMenuFlyoutItem
                    Click="SortOption_Click"
                    GroupName="Sort"
                    IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NameDesc, Mode=OneWay}"
                    Tag="NameDesc"
                    Text="Name (Z-A)"
                    x:Uid="/Models/Sort_NameDesc" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem
                    Click="SortOption_Click"
                    GroupName="Sort"
                    IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PriceLowHigh, Mode=OneWay}"
                    Tag="PriceLowHigh"
                    Text="Pricing: Low to High"
                    x:Uid="/Models/Sort_PriceLow" />
                <RadioMenuFlyoutItem
                    Click="SortOption_Click"
                    GroupName="Sort"
                    IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PriceHighLow, Mode=OneWay}"
                    Tag="PriceHighLow"
                    Text="Pricing: High to Low"
                    x:Uid="/Models/Sort_PriceHigh" />
            </MenuFlyout>
        </DropDownButton.Flyout>
    </DropDownButton>
</UserControl>

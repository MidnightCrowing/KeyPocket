<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:KeyPocket.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Models/ModelsPage.Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Provider Group Template  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ProviderGroupTemplate">
                <ctk:DataRow DoubleTapped="ProviderGroup_DoubleTapped">
                    <!--  Provider Name & Icon  -->
                    <StackPanel
                        Background="Transparent"
                        MinHeight="24"
                        Orientation="Horizontal"
                        Spacing="8"
                        ToolTipService.ToolTip="Double click to edit provider settings"
                        VerticalAlignment="Center">
                        <!--  Icon  -->
                        <Grid
                            AllowDrop="False"
                            Height="16"
                            Width="16">
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind ((vm:ProviderGroupViewModel)Content).DefaultGlyph}"
                                Visibility="{x:Bind ((vm:ProviderGroupViewModel)Content).IsCustomIcon, Converter={StaticResource NegBoolToVis}, Mode=OneWay}" />
                            <BitmapIcon
                                ShowAsMonochrome="False"
                                UriSource="{x:Bind ((vm:ProviderGroupViewModel)Content).IconUri, Mode=OneWay}"
                                Visibility="{x:Bind ((vm:ProviderGroupViewModel)Content).IsCustomIcon, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind ((vm:ProviderGroupViewModel)Content).ProviderName}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!--  Empty cells for alignment  -->
                    <TextBlock />
                    <TextBlock />
                    <TextBlock />
                </ctk:DataRow>
            </DataTemplate>

            <!--  Template Selector  -->
            <helpers:ModelsItemTemplateSelector
                ModelTemplate="{StaticResource ModelItemTemplate}"
                ProviderTemplate="{StaticResource ProviderGroupTemplate}"
                x:Key="ModelsItemTemplateSelector" />

            <!--  Model Item Template  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ModelItemTemplate">
                <controls:ModelListItem Model="{Binding Content}" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Model Count  -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="15,15,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ModelsCountText, Mode=OneWay}"
                VerticalAlignment="Center" />

            <!--  Search Box  -->
            <TextBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                PlaceholderText="Search models..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="200"
                x:Uid="Models_SearchBox" />

            <!--  Filter Button  -->
            <DropDownButton Grid.Column="2" ToolTipService.ToolTip="Filter">
                <DropDownButton.Content>
                    <FontIcon FontSize="16" Glyph="&#xE71C;" />
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="16" Width="350">
                            <!--  Header + Reset Button  -->
                            <Grid>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Filters"
                                    VerticalAlignment="Center"
                                    x:Uid="Models_Filter_Title" />
                                <Button
                                    Click="ResetFilters_Click"
                                    Content="Reset"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource TextBlockButtonStyle}"
                                    x:Uid="Models_Filter_Reset" />
                            </Grid>

                            <!--  Capability Section  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Capability"
                                    x:Uid="Models_Filter_Capability" />
                                <ctk:Segmented
                                    ItemContainerStyle="{StaticResource CustomSegmentedItemStyle}"
                                    SelectionMode="Multiple"
                                    Style="{StaticResource ButtonSegmentedStyle}">
                                    <ctk:SegmentedItem
                                        Content="Text"
                                        IsSelected="{x:Bind ViewModel.IsTextSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Text/Chat models"
                                        x:Uid="Models_Segment_Text" />
                                    <ctk:SegmentedItem
                                        Content="File"
                                        IsSelected="{x:Bind ViewModel.IsFileSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="File processing models"
                                        x:Uid="Models_Segment_File" />
                                    <ctk:SegmentedItem
                                        Content="Image"
                                        IsSelected="{x:Bind ViewModel.IsImageSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Image models"
                                        x:Uid="Models_Segment_Image" />
                                    <ctk:SegmentedItem
                                        Content="Audio"
                                        IsSelected="{x:Bind ViewModel.IsAudioSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Audio models"
                                        x:Uid="Models_Segment_Audio" />
                                    <ctk:SegmentedItem
                                        Content="Video"
                                        IsSelected="{x:Bind ViewModel.IsVideoSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Video models"
                                        x:Uid="Models_Segment_Video" />
                                    <ctk:SegmentedItem
                                        Content="Embeddings"
                                        IsSelected="{x:Bind ViewModel.IsEmbeddingsSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Embedding models"
                                        x:Uid="Models_Segment_Embeddings" />
                                </ctk:Segmented>
                            </StackPanel>

                            <!--  Price Range Section  -->
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Prompt Pricing"
                                    x:Uid="Models_Filter_Pricing" />

                                <ctk:RangeSelector
                                    Maximum="6"
                                    Minimum="0"
                                    RangeEnd="{x:Bind ViewModel.MaxPriceIndex, Mode=TwoWay}"
                                    RangeStart="{x:Bind ViewModel.MinPriceIndex, Mode=TwoWay}"
                                    StepFrequency="1" />

                                <!--  Ticks  -->
                                <Grid Margin="0,-8,0,0" Padding="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="0"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="1"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="2"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="3"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="4"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="5"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="5"
                                        Height="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                </Grid>

                                <!--  Tick Labels  -->
                                <Grid Margin="0,0,0,-4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  0: Free  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Text="Free"
                                        x:Uid="Models_Filter_Price_Free" />

                                    <!--  1: 0.1  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.1" />
                                    </TextBlock>

                                    <!--  2: 0.2  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.2" />
                                    </TextBlock>

                                    <!--  3: 0.5  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.5" />
                                    </TextBlock>

                                    <!--  4: 1  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="3"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="1" />
                                    </TextBlock>

                                    <!--  5: 5  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="5" />
                                    </TextBlock>

                                    <!--  6: 10+  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="5"
                                        HorizontalAlignment="Right">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="10+" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!--  Favorites Filter  -->
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Status"
                                    x:Uid="Models_Filter_Status" />
                                <CheckBox
                                    Content="Show favorites only"
                                    IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                                    x:Uid="Models_Filter_FavoritesOnly" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--  Sort Button  -->
            <DropDownButton Grid.Column="3" ToolTipService.ToolTip="Sort">
                <DropDownButton.Content>
                    <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NameAsc, Mode=OneWay}"
                            Tag="NameAsc"
                            Text="Name (A-Z)"
                            x:Uid="Models_Sort_NameAsc" />
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NameDesc, Mode=OneWay}"
                            Tag="NameDesc"
                            Text="Name (Z-A)"
                            x:Uid="Models_Sort_NameDesc" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PriceLowHigh, Mode=OneWay}"
                            Tag="PriceLowHigh"
                            Text="Pricing: Low to High"
                            x:Uid="Models_Sort_PriceLow" />
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PriceHighLow, Mode=OneWay}"
                            Tag="PriceHighLow"
                            Text="Pricing: High to Low"
                            x:Uid="Models_Sort_PriceHigh" />

                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--  View Toggle  -->
            <ctk:Segmented
                Grid.Column="4"
                ItemContainerStyle="{StaticResource CustomSegmentedItemStyle}"
                SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}">
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="List view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="Card view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xECA5;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
            </ctk:Segmented>

        </Grid>

        <!--  List / Card Switcher  -->
        <ctk:SwitchPresenter Grid.Row="1" Value="{x:Bind ViewModel.ViewMode, Mode=OneWay}">
            <ctk:Case Value="{x:Bind vm:ModelsViewMode.List}">
                <!--  HeaderedTreeView with DataTable  -->
                <ctk:HeaderedTreeView ItemTemplateSelector="{StaticResource ModelsItemTemplateSelector}" x:Name="ModelsTreeView">
                    <ctk:HeaderedTreeView.Header>
                        <ctk:DataTable ColumnSpacing="16" Margin="16,0">
                            <!--  Provider Name Column (Auto width handles indentation)  -->
                            <ctk:DataColumn
                                Content="Provider"
                                DesiredWidth="Auto"
                                x:Uid="Models_List_Provider" />
                            <!--  Model Name Column  -->
                            <ctk:DataColumn
                                Content="Model Name"
                                DesiredWidth="*"
                                x:Uid="Models_List_ModelName" />
                            <!--  Input Price Column  -->
                            <ctk:DataColumn Content="{x:Bind ViewModel.InputPriceHeader, Mode=OneWay}" DesiredWidth="160" />
                            <!--  Output Price Column  -->
                            <ctk:DataColumn Content="{x:Bind ViewModel.OutputPriceHeader, Mode=OneWay}" DesiredWidth="160" />
                        </ctk:DataTable>
                    </ctk:HeaderedTreeView.Header>
                </ctk:HeaderedTreeView>
            </ctk:Case>
            <ctk:Case Value="{x:Bind vm:ModelsViewMode.Card}">
                <!--  Card View  -->
                <ScrollViewer>
                    <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.FilteredModels, Mode=OneWay}">
                        <muxc:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModelItemViewModel">
                                <controls:ModelCardItem Model="{x:Bind}" />
                            </DataTemplate>
                        </muxc:ItemsRepeater.ItemTemplate>
                        <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="300"
                                MinRowSpacing="12"
                                Orientation="Horizontal" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </ctk:Case>
        </ctk:SwitchPresenter>
    </Grid>
</Page>
<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                HorizontalAlignment="Left"
                PlaceholderText="Search models..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="300" />

            <!--  Filters & Sort  -->
            <!--  Capability  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Capability:"
                    VerticalAlignment="Center" />
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.Capabilities}"
                    SelectedItem="{x:Bind ViewModel.SelectedCapability, Mode=TwoWay}"
                    Width="140" />
            </StackPanel>

            <!--  Sort  -->
            <StackPanel
                Grid.Column="2"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Sort by:"
                    VerticalAlignment="Center" />
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                    Width="140" />
            </StackPanel>


            <ToggleButton
                Grid.Column="3"
                IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                Margin="0,0,0,6"
                VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE735;" />
                    <TextBlock Text="Favorites" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!--  Content  -->
        <GridView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.FilteredModels, Mode=OneWay}"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ModelItemViewModel">
                    <Grid
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="170"
                        Padding="0"
                        Width="280">

                        <Grid Padding="16" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header: Provider Info + Favorite  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Opacity="0.7"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ProviderName}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--  Toggle Favorite Button  -->
                                <Grid Grid.Column="1">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        Padding="4"
                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource NegBoolToVis}}">
                                        <FontIcon FontSize="16" Glyph="&#xE734;" />
                                    </Button>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        Padding="4"
                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="#F2C811"
                                            Glyph="&#xE735;" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <!--  Model Name  -->
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,2,0,0"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind DisplayName}" />

                            <!--  Tags Area & Price  -->
                            <StackPanel
                                Grid.Row="2"
                                Spacing="6"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border
                                        Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Visibility="{x:Bind IsChatModel, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Chat" />
                                    </Border>
                                    <Border
                                        Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Visibility="{x:Bind IsEmbeddingModel, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Embedding" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        Opacity="0.6"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="In:" />
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind InputPriceFormatted}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        Opacity="0.6"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Out:" />
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind OutputPriceFormatted}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Footer: ID  -->
                            <Grid ColumnSpacing="8" Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Opacity="0.8"
                                        Text="{x:Bind Id}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Id}" />
                                </Border>
                                <controls:CopyButton
                                    Click="CopyButton_Click"
                                    Content="&#xE8C8;"
                                    Grid.Column="1"
                                    Padding="6"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copy ID" />
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

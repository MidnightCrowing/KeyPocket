<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:KeyPocket.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Converters  -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
            <converters:BoolToDoubleConverter x:Key="BoolToOpacity" />
            <converters:FavoriteIconConverter x:Key="BoolToGlyphConverter" />
            <converters:FavoriteColorConverter x:Key="BoolToBrushConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />

            <!--  Custom Segmented Item Style  -->
            <Style
                BasedOn="{StaticResource ButtonSegmentedItemStyle}"
                TargetType="ctk:SegmentedItem"
                x:Key="CustomSegmentedItemStyle">
                <Setter Property="Padding" Value="8,5" />
            </Style>

            <!--  Template Selector  -->
            <helpers:ModelsItemTemplateSelector
                ModelTemplate="{StaticResource ModelItemTemplate}"
                ProviderTemplate="{StaticResource ProviderGroupTemplate}"
                x:Key="ModelsItemTemplateSelector" />

            <!--  Model Item Template  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ModelItemTemplate">
                <ctk:DataRow>
                    <!--  Provider column (Spacer)  -->
                    <TextBlock />

                    <!--  Model Name + Actions (Favorite/Copy)  -->
                    <Grid
                        Background="Transparent"
                        HorizontalAlignment="Stretch"
                        PointerEntered="ModelItem_PointerEntered"
                        PointerExited="ModelItem_PointerExited"
                        VerticalAlignment="Center">
                        <!--  Transparent background to catch pointer events  -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Derived Model Icon (Custom Avatar Style)  -->
                        <Grid
                            Height="20"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="20">
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Visibility="{x:Bind ((vm:ModelItemViewModel)Content).HasModelIcon, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                <BitmapIcon
                                    Height="12"
                                    HorizontalAlignment="Center"
                                    ShowAsMonochrome="False"
                                    UriSource="{x:Bind ((vm:ModelItemViewModel)Content).ModelIconUri, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    Width="12" />
                            </Border>
                        </Grid>

                        <!--  Name  -->
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).DisplayName}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />

                        <!--  Actions - Copy (Next to Name)  -->
                        <controls:CopyButton
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CopyButton_Click"
                            Grid.Column="2"
                            Height="28"
                            Margin="4,0,0,0"
                            Opacity="0"
                            Padding="4"
                            Tag="{x:Bind ((vm:ModelItemViewModel)Content).Id, Mode=OneWay}"
                            ToolTipService.ToolTip="Copy ID"
                            VerticalAlignment="Center"
                            Width="28"
                            x:Name="CopyBtn">
                            <!--  Interaction handled in code-behind  -->
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        </controls:CopyButton>

                        <!--  Actions - Favorite (Far Right)  -->
                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ((vm:ModelItemViewModel)Content).ToggleFavoriteCommand}"
                            Grid.Column="4"
                            Height="28"
                            Opacity="{x:Bind ((vm:ModelItemViewModel)Content).IsFavorite, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                            Padding="4"
                            ToolTipService.ToolTip="Favorite"
                            VerticalAlignment="Center"
                            Width="28"
                            x:Name="FavoriteBtn">
                            <FontIcon
                                FontSize="14"
                                Foreground="{x:Bind ((vm:ModelItemViewModel)Content).IsFavorite, Mode=OneWay, Converter={StaticResource BoolToBrushConverter}}"
                                Glyph="{x:Bind ((vm:ModelItemViewModel)Content).IsFavorite, Mode=OneWay, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter='Fill'}" />
                        </Button>
                    </Grid>

                    <!--  Input Price  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).InputPriceFormatted}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontFamily="Consolas"
                            Opacity="0.5"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).InputPriceOriginal}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!--  Output Price  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).OutputPriceFormatted}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontFamily="Consolas"
                            Opacity="0.5"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).OutputPriceOriginal}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </ctk:DataRow>
            </DataTemplate>

            <!--  Provider Group Template  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ProviderGroupTemplate">
                <ctk:DataRow>
                    <!--  Provider Name & Icon  -->
                    <StackPanel
                        Background="Transparent"
                        DoubleTapped="ProviderGroup_DoubleTapped"
                        MinHeight="24"
                        Orientation="Horizontal"
                        Spacing="8"
                        ToolTipService.ToolTip="Double click to edit provider settings"
                        VerticalAlignment="Center">
                        <!--  Icon  -->
                        <Grid
                            AllowDrop="False"
                            Height="16"
                            Width="16">
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind ((vm:ProviderGroupViewModel)Content).DefaultGlyph}"
                                Visibility="{x:Bind ((vm:ProviderGroupViewModel)Content).IsCustomIcon, Converter={StaticResource NegBoolToVis}, Mode=OneWay}" />
                            <BitmapIcon
                                ShowAsMonochrome="False"
                                UriSource="{x:Bind ((vm:ProviderGroupViewModel)Content).IconUri, Mode=OneWay}"
                                Visibility="{x:Bind ((vm:ProviderGroupViewModel)Content).IsCustomIcon, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind ((vm:ProviderGroupViewModel)Content).ProviderName}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!--  Empty cells for alignment  -->
                    <TextBlock />
                    <TextBlock />
                    <TextBlock />
                </ctk:DataRow>
            </DataTemplate>

            <!--  Model Card Template  -->
            <DataTemplate x:DataType="vm:ModelItemViewModel" x:Key="ModelCardTemplate">
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                    <StackPanel Spacing="12">
                        <!--  Header  -->
                        <Grid
                            ColumnSpacing="8"
                            PointerEntered="ModelCard_PointerEntered"
                            PointerExited="ModelCard_PointerExited">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Model Icon  -->
                            <Grid
                                Height="20"
                                VerticalAlignment="Center"
                                Width="20">
                                <Border
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Visibility="{x:Bind HasModelIcon, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <BitmapIcon
                                        Height="12"
                                        HorizontalAlignment="Center"
                                        ShowAsMonochrome="False"
                                        UriSource="{x:Bind ModelIconUri, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        Width="12" />
                                </Border>
                            </Grid>

                            <!--  Model Name  -->
                            <TextBlock
                                FontWeight="SemiBold"
                                Grid.Column="1"
                                Text="{x:Bind DisplayName}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />

                            <!--  Copy  -->
                            <controls:CopyButton
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CopyButton_Click"
                                Grid.Column="3"
                                Height="28"
                                Opacity="0"
                                Padding="4"
                                Tag="{x:Bind Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Copy ID"
                                VerticalAlignment="Center"
                                Width="28"
                                x:Name="CardCopyBtn">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </controls:CopyButton>

                            <!--  Favorite  -->
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ToggleFavoriteCommand}"
                                Grid.Column="2"
                                Height="28"
                                Opacity="{x:Bind IsFavorite, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                                Padding="4"
                                ToolTipService.ToolTip="Favorite"
                                VerticalAlignment="Center"
                                Width="28"
                                x:Name="CardFavoriteBtn">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToBrushConverter}}"
                                    Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter='Fill'}" />
                            </Button>
                        </Grid>

                        <!--  Tags  -->
                        <ItemsControl ItemsSource="{x:Bind CapabilityTags, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="8,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse
                                                Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Height="4"
                                                VerticalAlignment="Center"
                                                Width="4" />
                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Footer  -->
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis">
                            <Run Text="by " />
                            <Run Text="{x:Bind ProviderName}" />
                            <Run Text=" | " />
                            <Run Text="In:" />
                            <Run Text="{x:Bind InputPriceFormatted}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind InputPriceOriginal}" />
                            <Run Text=" | " />
                            <Run Text="Out:" />
                            <Run Text="{x:Bind OutputPriceFormatted}" />
                            <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind OutputPriceOriginal}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Search Box  -->
            <TextBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                PlaceholderText="Search models..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="200"
                x:Uid="Models_SearchBox" />

            <!--  Filter Button  -->
            <DropDownButton Grid.Column="2" ToolTipService.ToolTip="Filter">
                <DropDownButton.Content>
                    <FontIcon FontSize="16" Glyph="&#xE71C;" />
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="16" Width="350">
                            <!--  Header + Reset Button  -->
                            <Grid>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="Filters"
                                    VerticalAlignment="Center" />
                                <Button
                                    Click="ResetFilters_Click"
                                    Content="Reset"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource TextBlockButtonStyle}" />
                            </Grid>

                            <!--  Capability Section  -->
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Capability" />
                                <ctk:Segmented
                                    ItemContainerStyle="{StaticResource CustomSegmentedItemStyle}"
                                    SelectionMode="Multiple"
                                    Style="{StaticResource ButtonSegmentedStyle}">
                                    <ctk:SegmentedItem
                                        Content="Text"
                                        IsSelected="{x:Bind ViewModel.IsTextSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Text/Chat models" />
                                    <ctk:SegmentedItem
                                        Content="File"
                                        IsSelected="{x:Bind ViewModel.IsFileSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="File processing models" />
                                    <ctk:SegmentedItem
                                        Content="Image"
                                        IsSelected="{x:Bind ViewModel.IsImageSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Image models" />
                                    <ctk:SegmentedItem
                                        Content="Audio"
                                        IsSelected="{x:Bind ViewModel.IsAudioSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Audio models" />
                                    <ctk:SegmentedItem
                                        Content="Video"
                                        IsSelected="{x:Bind ViewModel.IsVideoSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Video models" />
                                    <ctk:SegmentedItem
                                        Content="Embeddings"
                                        IsSelected="{x:Bind ViewModel.IsEmbeddingsSelected, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Embedding models" />
                                </ctk:Segmented>
                            </StackPanel>

                            <!--  Price Range Section  -->
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Prompt Pricing" />

                                <ctk:RangeSelector
                                    Maximum="6"
                                    Minimum="0"
                                    RangeEnd="{x:Bind ViewModel.MaxPriceIndex, Mode=TwoWay}"
                                    RangeStart="{x:Bind ViewModel.MinPriceIndex, Mode=TwoWay}"
                                    StepFrequency="1" />

                                <!--  Ticks  -->
                                <Grid Margin="0,-8,0,0" Padding="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="0"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="1"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="2"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="3"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="4"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="5"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                    <Rectangle
                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="5"
                                        Height="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Width="1" />
                                </Grid>

                                <!--  Tick Labels  -->
                                <Grid Margin="0,0,0,-4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  0: Free  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="0"
                                        HorizontalAlignment="Left"
                                        Text="Free" />

                                    <!--  1: 0.1  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.1" />
                                    </TextBlock>

                                    <!--  2: 0.2  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.2" />
                                    </TextBlock>

                                    <!--  3: 0.5  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="0.5" />
                                    </TextBlock>

                                    <!--  4: 1  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="3"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="1" />
                                    </TextBlock>

                                    <!--  5: 5  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="4"
                                        Grid.ColumnSpan="2"
                                        HorizontalAlignment="Center">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="5" />
                                    </TextBlock>

                                    <!--  6: 10+  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Grid.Column="5"
                                        HorizontalAlignment="Right">
                                        <Run Text="{x:Bind ViewModel.CurrencySymbol, Mode=OneWay}" /><Run Text="10+" />
                                    </TextBlock>
                                </Grid>
                            </StackPanel>

                            <!--  Favorites Filter  -->
                            <StackPanel Spacing="8">
                                <TextBlock FontWeight="SemiBold" Text="Status" />
                                <CheckBox Content="Show favorites only" IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--  Sort Button  -->
            <DropDownButton Grid.Column="3" ToolTipService.ToolTip="Sort">
                <DropDownButton.Content>
                    <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NameAsc, Mode=OneWay}"
                            Tag="NameAsc"
                            Text="Name (A-Z)" />
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=NameDesc, Mode=OneWay}"
                            Tag="NameDesc"
                            Text="Name (Z-A)" />
                        <MenuFlyoutSeparator />
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PriceLowHigh, Mode=OneWay}"
                            Tag="PriceLowHigh"
                            Text="Pricing: Low to High" />
                        <RadioMenuFlyoutItem
                            Click="SortOption_Click"
                            GroupName="Sort"
                            IsChecked="{x:Bind ViewModel.SortOption, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PriceHighLow, Mode=OneWay}"
                            Tag="PriceHighLow"
                            Text="Pricing: High to Low" />

                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!--  View Toggle  -->
            <ctk:Segmented
                Grid.Column="4"
                ItemContainerStyle="{StaticResource CustomSegmentedItemStyle}"
                SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}">
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="List view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="Card view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xECA5;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
            </ctk:Segmented>

        </Grid>

        <!--  List / Card Switcher  -->
        <ctk:SwitchPresenter Grid.Row="1" Value="{x:Bind ViewModel.ViewMode, Mode=OneWay}">
            <ctk:Case Value="{x:Bind vm:ModelsViewMode.List}">
                <!--  HeaderedTreeView with DataTable  -->
                <ctk:HeaderedTreeView ItemTemplateSelector="{StaticResource ModelsItemTemplateSelector}" x:Name="ModelsTreeView">
                    <ctk:HeaderedTreeView.Header>
                        <ctk:DataTable ColumnSpacing="16" Margin="16,0">
                            <!--  Provider Name Column (Auto width handles indentation)  -->
                            <ctk:DataColumn Content="Provider" DesiredWidth="Auto" />
                            <!--  Model Name Column  -->
                            <ctk:DataColumn Content="Model Name" DesiredWidth="*" />
                            <!--  Input Price Column  -->
                            <ctk:DataColumn Content="{x:Bind ViewModel.InputPriceHeader, Mode=OneWay}" DesiredWidth="160" />
                            <!--  Output Price Column  -->
                            <ctk:DataColumn Content="{x:Bind ViewModel.OutputPriceHeader, Mode=OneWay}" DesiredWidth="160" />
                        </ctk:DataTable>
                    </ctk:HeaderedTreeView.Header>
                </ctk:HeaderedTreeView>
            </ctk:Case>
            <ctk:Case Value="{x:Bind vm:ModelsViewMode.Card}">
                <!--  Card View  -->
                <ScrollViewer>
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource ModelCardTemplate}" ItemsSource="{x:Bind ViewModel.FilteredModels, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="300"
                                MinRowSpacing="12"
                                Orientation="Horizontal" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </ctk:Case>
        </ctk:SwitchPresenter>
    </Grid>
</Page>
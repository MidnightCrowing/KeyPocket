<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:KeyPocket.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />

            <!--  Model Item Template  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ModelItemTemplate">
                <ctk:DataRow>
                    <!--  Provider column (Spacer)  -->
                    <TextBlock />

                    <!--  Model Name + Copy Button  -->
                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).DisplayName}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <controls:CopyButton
                            Click="CopyButton_Click"
                            Content="&#xE8C8;"
                            Grid.Column="1"
                            Height="28"
                            Margin="8,0,0,0"
                            Padding="4"
                            Tag="{x:Bind ((vm:ModelItemViewModel)Content).Id, Mode=OneWay}"
                            ToolTipService.ToolTip="Copy ID"
                            Width="28"
                            x:Uid="Models_CopyID" />
                    </Grid>

                    <!--  Input Price  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).InputPriceFormatted}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontFamily="Consolas"
                            Opacity="0.5"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).InputPriceOriginal}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!--  Output Price  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="Consolas"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).OutputPriceFormatted}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontFamily="Consolas"
                            Opacity="0.5"
                            Text="{x:Bind ((vm:ModelItemViewModel)Content).OutputPriceOriginal}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </ctk:DataRow>
            </DataTemplate>

            <!--  Provider Group Template  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ProviderGroupTemplate">
                <ctk:DataRow>
                    <!--  Provider Name  -->
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ((vm:ProviderGroupViewModel)Content).ProviderName}"
                        VerticalAlignment="Center" />
                    <!--  Empty cells for alignment  -->
                    <TextBlock />
                    <TextBlock />
                    <TextBlock />
                </ctk:DataRow>
            </DataTemplate>

            <!--  Template Selector  -->
            <helpers:ModelsItemTemplateSelector
                ModelTemplate="{StaticResource ModelItemTemplate}"
                ProviderTemplate="{StaticResource ProviderGroupTemplate}"
                x:Key="ModelsItemTemplateSelector" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                HorizontalAlignment="Left"
                PlaceholderText="Search models..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="300"
                x:Uid="Models_SearchBox" />

            <!--  Filters & Sort  -->
            <!--  Capability  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Capability:"
                    VerticalAlignment="Center"
                    x:Uid="Models_Capability" />
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.Capabilities}"
                    SelectedItem="{x:Bind ViewModel.SelectedCapability, Mode=TwoWay}"
                    Width="140" />
            </StackPanel>

            <!--  Sort  -->
            <StackPanel
                Grid.Column="2"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Sort by:"
                    VerticalAlignment="Center"
                    x:Uid="Models_SortBy" />
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                    Width="140" />
            </StackPanel>


            <ToggleButton
                Grid.Column="3"
                IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                Margin="0,0,0,6"
                VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE735;" />
                    <TextBlock Text="Favorites" x:Uid="Models_Favorites" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!--  Content: HeaderedTreeView with DataTable  -->
        <!--  Grid.ColumnSpan="4" to fix width issue if Grid has columns defined in prev implementation (it doesn't, main grid has 1 col usually)  -->
        <!--  Wait, main grid has 2 rows.  -->
        <ctk:HeaderedTreeView
            Grid.Row="1"
            ItemTemplateSelector="{StaticResource ModelsItemTemplateSelector}"
            x:Name="ModelsTreeView">
            <ctk:HeaderedTreeView.Header>
                <ctk:DataTable ColumnSpacing="16" Margin="16,0">
                    <!--  Provider Name Column (Auto width handles indentation)  -->
                    <ctk:DataColumn Content="Provider" DesiredWidth="Auto" />
                    <!--  Model Name Column  -->
                    <ctk:DataColumn Content="Model Name" DesiredWidth="*" />
                    <!--  Input Price Column  -->
                    <ctk:DataColumn Content="Input ($/1M)" DesiredWidth="150" />
                    <!--  Output Price Column  -->
                    <ctk:DataColumn Content="Output ($/1M)" DesiredWidth="150" />
                </ctk:DataTable>
            </ctk:HeaderedTreeView.Header>
        </ctk:HeaderedTreeView>
    </Grid>
</Page>
<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:KeyPocket.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Converters  -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
            <converters:BoolToDoubleConverter x:Key="BoolToOpacity" />
            <converters:FavoriteIconConverter x:Key="BoolToGlyphConverter" />
            <converters:FavoriteColorConverter x:Key="BoolToBrushConverter" />

             <!--  Custom Segmented Item Style  -->
            <Style
                BasedOn="{StaticResource ButtonSegmentedItemStyle}"
                TargetType="ctk:SegmentedItem"
                x:Key="CustomSegmentedItemStyle">
                <Setter Property="Padding" Value="8,5" />
            </Style>

            <!--  Template Selector  -->
            <helpers:KeysItemTemplateSelector
                KeyTemplate="{StaticResource KeyItemTemplate}"
                ProviderTemplate="{StaticResource ProviderGroupTemplate}"
                x:Key="KeysItemTemplateSelector" />

            <!--  Key Item Template (TreeView Row)  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="KeyItemTemplate">
                <ctk:DataRow>
                    <!--  Provider column (Spacer/Indentation)  -->
                    <TextBlock />

                    <!--  Key Value + Actions  -->
                    <Grid 
                        VerticalAlignment="Center" 
                        Margin="0,0,16,0"
                        Background="Transparent"
                        PointerEntered="KeyItem_PointerEntered"
                        PointerExited="KeyItem_PointerExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            
                            <!--  Key Text (Masked)  -->
                            <TextBlock
                                FontFamily="Consolas"
                                Text="{x:Bind ((vm:KeyItemViewModel)Content).DisplayKey, Mode=OneWay}"
                                VerticalAlignment="Center" 
                                ToolTipService.ToolTip="{x:Bind ((vm:KeyItemViewModel)Content).MaskedKey, Mode=OneWay}"/>
                            
                            <!--  Actions (Copy)  -->
                             <controls:CopyButton
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CopyButton_Click"
                                Height="24"
                                Opacity="0"
                                Padding="2"
                                Tag="{x:Bind ((vm:KeyItemViewModel)Content).Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Copy Key"
                                VerticalAlignment="Center"
                                Width="24"
                                x:Name="CopyBtn"
                                x:Uid="Keys_CopyKey">
                                <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                            </controls:CopyButton>
                        </StackPanel>

                        <!-- Favorite (Far right of the cell) -->
                         <Button
                            Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ((vm:KeyItemViewModel)Content).ToggleFavoriteCommand}"
                            Height="24"
                            Opacity="{x:Bind ((vm:KeyItemViewModel)Content).IsFavorite, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                            Padding="2"
                            ToolTipService.ToolTip="{x:Bind ((vm:KeyItemViewModel)Content).IsFavorite, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Width="24"
                            x:Name="FavoriteBtn"
                            x:Uid="Keys_Favorites">
                            <FontIcon
                                FontSize="12"
                                Foreground="{x:Bind ((vm:KeyItemViewModel)Content).IsFavorite, Mode=OneWay, Converter={StaticResource BoolToBrushConverter}}"
                                Glyph="{x:Bind ((vm:KeyItemViewModel)Content).IsFavorite, Mode=OneWay, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter='Fill'}" />
                        </Button>
                    </Grid>

                    <!--  Tag Column (Inline Edit) -->
                    <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                        <!-- Display Mode -->
                        <Button
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Visibility="{x:Bind ((vm:KeyItemViewModel)Content).IsEditingTag, Converter={StaticResource NegBoolToVis}, Mode=OneWay}"
                            Command="{x:Bind ((vm:KeyItemViewModel)Content).StartEditTagCommand}">
                            <TextBlock
                                FontSize="12"
                                Text="{x:Bind ((vm:KeyItemViewModel)Content).Tag, Mode=OneWay, TargetNullValue='Add Tag...'}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Button>

                        <!-- Edit Mode -->
                        <TextBox
                            x:Name="TagTextBox"
                            FontSize="12"
                            Padding="8,4"
                            MinHeight="0"
                            Text="{x:Bind ((vm:KeyItemViewModel)Content).Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ((vm:KeyItemViewModel)Content).IsEditingTag, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                            KeyDown="TagTextBox_KeyDown"
                            Loaded="TagTextBox_Loaded"
                            LostFocus="TagTextBox_LostFocus"/>
                    </Grid>

                </ctk:DataRow>
            </DataTemplate>

            <!--  Provider Group Template  -->
            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ProviderGroupTemplate">
                <ctk:DataRow>
                    <!--  Provider Name & Icon  -->
                    <StackPanel
                        Background="Transparent"
                        MinHeight="24"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <!--  Icon  -->
                        <Grid
                            AllowDrop="False"
                            Height="16"
                            Width="16">
                            <FontIcon
                                FontSize="16"
                                Glyph="{x:Bind ((vm:KeyProviderGroupViewModel)Content).DefaultGlyph}"
                                Visibility="{x:Bind ((vm:KeyProviderGroupViewModel)Content).IsCustomIcon, Converter={StaticResource NegBoolToVis}, Mode=OneWay}" />
                            <BitmapIcon
                                ShowAsMonochrome="False"
                                UriSource="{x:Bind ((vm:KeyProviderGroupViewModel)Content).IconUri, Mode=OneWay}"
                                Visibility="{x:Bind ((vm:KeyProviderGroupViewModel)Content).IsCustomIcon, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind ((vm:KeyProviderGroupViewModel)Content).ProviderName}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <!--  Empty cells for alignment  -->
                    <TextBlock />
                    <TextBlock />
                </ctk:DataRow>
            </DataTemplate>

            <!--  Key Card Template  -->
            <DataTemplate x:DataType="vm:KeyItemViewModel" x:Key="KeyCardTemplate">
                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    PointerEntered="KeyCard_PointerEntered"
                    PointerExited="KeyCard_PointerExited">
                    <StackPanel Spacing="12">
                        <!--  Header  -->
                        <Grid ColumnSpacing="8">
                             <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Provider Icon -->
                             <FontIcon Glyph="&#xE8D7;" FontSize="16" />

                            <!--  Provider Name  -->
                            <TextBlock
                                FontWeight="SemiBold"
                                Grid.Column="1"
                                Text="{x:Bind ProviderName}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />

                            <!--  Favorite (Far right)  -->
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ToggleFavoriteCommand}"
                                Grid.Column="2"
                                Height="28"
                                Opacity="{x:Bind IsFavorite, Converter={StaticResource BoolToOpacity}, Mode=OneWay}"
                                Padding="4"
                                ToolTipService.ToolTip="Favorite"
                                VerticalAlignment="Center"
                                Width="28"
                                x:Name="CardFavoriteBtn"
                                x:Uid="Keys_Favorites">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToBrushConverter}}"
                                    Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter='Fill'}" />
                            </Button>
                        </Grid>

                        <!--  Key Value + Copy  -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                             <TextBlock
                                FontFamily="Consolas"
                                Text="{x:Bind DisplayKey}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
                            
                             <controls:CopyButton
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CopyButton_Click"
                                Height="28"
                                Opacity="0"
                                Padding="4"
                                Tag="{x:Bind Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Copy Key"
                                VerticalAlignment="Center"
                                Width="28"
                                x:Name="CardCopyBtn"
                                x:Uid="Keys_CopyKey">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </controls:CopyButton>
                        </StackPanel>

                        <!--  Tag (Inline Edit)  -->
                        <Grid HorizontalAlignment="Left">
                            <!-- Display Mode -->
                            <Button
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Visibility="{x:Bind IsEditingTag, Converter={StaticResource NegBoolToVis}, Mode=OneWay}"
                                Command="{x:Bind StartEditTagCommand}">
                                 <Border
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Visibility="{x:Bind HasTag, Converter={StaticResource BoolToVis}, Mode=OneWay}"> 
                                     <TextBlock
                                        FontSize="12"
                                        Text="{x:Bind Tag}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Button>

                            <!-- Edit Mode -->
                            <TextBox
                                x:Name="CardTagTextBox"
                                FontSize="12"
                                Padding="8,4"
                                MinHeight="0"
                                Width="200"
                                Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind IsEditingTag, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                KeyDown="TagTextBox_KeyDown"
                                Loaded="TagTextBox_Loaded"
                                LostFocus="TagTextBox_LostFocus"/>
                        </Grid>

                        <!--  Created Date (Footer)  -->
                         <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{x:Bind FormattedCreatedAt}" />
                         </TextBlock>

                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Keys Count  -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="15,15,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.KeysCountText, Mode=OneWay}"
                VerticalAlignment="Center" />

            <!--  Search Box  -->
            <TextBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                PlaceholderText="Search tags..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="200"
                x:Uid="Keys_SearchBox" />

             <!--  Favorites Filter  -->
             <ToggleButton
                Grid.Column="2" 
                IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                ToolTipService.ToolTip="Show favorites only">
                <FontIcon FontSize="16" Glyph="&#xE735;" />
            </ToggleButton>

            <!--  View Toggle  -->
            <ctk:Segmented
                Grid.Column="3"
                ItemContainerStyle="{StaticResource CustomSegmentedItemStyle}"
                SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}">
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="List view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="Card view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xECA5;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
            </ctk:Segmented>
        </Grid>

        <!--  List / Card Switcher  -->
        <ctk:SwitchPresenter Grid.Row="1" Value="{x:Bind ViewModel.ViewMode, Mode=OneWay}">
             <ctk:Case Value="{x:Bind vm:KeysViewMode.List}">
                <!--  HeaderedTreeView with DataTable  -->
                 <ctk:HeaderedTreeView ItemTemplateSelector="{StaticResource KeysItemTemplateSelector}" Loaded="KeysTreeView_Loaded" x:Name="KeysTreeView">
                    <ctk:HeaderedTreeView.Header>
                        <ctk:DataTable ColumnSpacing="16" Margin="16,0">
                             <!--  Provider Name Column (Auto)  -->
                             <ctk:DataColumn
                                Content="Provider"
                                DesiredWidth="Auto"
                                x:Uid="Keys_List_Provider" />
                             <!--  Key Column (*)  -->
                             <ctk:DataColumn
                                Content="Key"
                                DesiredWidth="*"
                                x:Uid="Keys_List_Key" />
                             <!--  Tag Column (Auto)  -->
                             <ctk:DataColumn
                                Content="Tag"
                                DesiredWidth="150"
                                x:Uid="Keys_List_Tag" />
                        </ctk:DataTable>
                    </ctk:HeaderedTreeView.Header>
                 </ctk:HeaderedTreeView>
             </ctk:Case>
             <ctk:Case Value="{x:Bind vm:KeysViewMode.Card}">
                  <ScrollViewer>
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource KeyCardTemplate}" ItemsSource="{x:Bind ViewModel.FilteredKeys, Mode=OneWay}">
                         <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="300"
                                MinRowSpacing="12"
                                Orientation="Horizontal" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                  </ScrollViewer>
             </ctk:Case>
        </ctk:SwitchPresenter>
    </Grid>
</Page>
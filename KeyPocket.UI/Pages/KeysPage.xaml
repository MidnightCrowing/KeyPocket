<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:KeyPocket.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <Style
                BasedOn="{StaticResource ButtonSegmentedItemStyle}"
                TargetType="ctk:SegmentedItem"
                x:Key="CustomSegmentedItemStyle">
                <Setter Property="Padding" Value="8,5" />
            </Style>

            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="KeyItemTemplate">
                <controls:KeyListItem KeyItem="{Binding Content}" />
            </DataTemplate>

            <DataTemplate x:DataType="muxc:TreeViewNode" x:Key="ProviderGroupTemplate">
                <controls:KeyProviderGroupItem Group="{Binding Content}" NavigateRequested="OnProviderGroupDoubleTapped" />
            </DataTemplate>

            <DataTemplate x:DataType="vm:KeyItemViewModel" x:Key="KeyCardTemplate">
                <controls:KeyCardItem KeyItem="{x:Bind}" />
            </DataTemplate>

            <helpers:KeysItemTemplateSelector
                KeyTemplate="{StaticResource KeyItemTemplate}"
                ProviderTemplate="{StaticResource ProviderGroupTemplate}"
                x:Key="KeysItemTemplateSelector" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Keys Count  -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Margin="15,15,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.KeysCountText, Mode=OneWay}"
                VerticalAlignment="Center" />

            <!--  Search Box  -->
            <TextBox
                Grid.Column="1"
                HorizontalAlignment="Right"
                PlaceholderText="Search tags..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="200"
                x:Uid="Keys/SearchBox" />

            <!--  Favorites Filter  -->
            <ToggleButton
                Grid.Column="2"
                IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                ToolTipService.ToolTip="Show favorites only">
                <FontIcon FontSize="16" Glyph="&#xE735;" />
            </ToggleButton>

            <!--  View Toggle  -->
            <ctk:Segmented
                Grid.Column="3"
                ItemContainerStyle="{StaticResource CustomSegmentedItemStyle}"
                SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}">
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="List view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
                <ctk:SegmentedItem Height="28.8" ToolTipService.ToolTip="Card view">
                    <ctk:SegmentedItem.Content>
                        <FontIcon FontSize="16" Glyph="&#xECA5;" />
                    </ctk:SegmentedItem.Content>
                </ctk:SegmentedItem>
            </ctk:Segmented>
        </Grid>

        <!--  List / Card Switcher  -->
        <ctk:SwitchPresenter Grid.Row="1" Value="{x:Bind ViewModel.ViewMode, Mode=OneWay}">
            <ctk:Case Value="{x:Bind vm:KeysViewMode.List}">
                <!--  HeaderedTreeView with DataTable  -->
                <ctk:HeaderedTreeView
                    ItemTemplateSelector="{StaticResource KeysItemTemplateSelector}"
                    Loaded="KeysTreeView_Loaded"
                    x:Name="KeysTreeView">
                    <ctk:HeaderedTreeView.Header>
                        <ctk:DataTable ColumnSpacing="16" Margin="16,0">
                            <!--  Provider Name Column (Auto)  -->
                            <ctk:DataColumn
                                Content="Provider"
                                DesiredWidth="Auto"
                                x:Uid="Keys/List_Provider" />
                            <!--  Key Column (*)  -->
                            <ctk:DataColumn
                                Content="Key"
                                DesiredWidth="*"
                                x:Uid="Keys/List_Key" />
                            <!--  Tag Column (Auto)  -->
                            <ctk:DataColumn
                                Content="Tag"
                                DesiredWidth="150"
                                x:Uid="Keys/List_Tag" />
                        </ctk:DataTable>
                    </ctk:HeaderedTreeView.Header>
                </ctk:HeaderedTreeView>
            </ctk:Case>
            <ctk:Case Value="{x:Bind vm:KeysViewMode.Card}">
                <ScrollViewer>
                    <muxc:ItemsRepeater ItemTemplate="{StaticResource KeyCardTemplate}" ItemsSource="{x:Bind ViewModel.FilteredKeys, Mode=OneWay}">
                        <muxc:ItemsRepeater.Layout>
                            <muxc:UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="12"
                                MinItemWidth="300"
                                MinRowSpacing="12"
                                Orientation="Horizontal" />
                        </muxc:ItemsRepeater.Layout>
                    </muxc:ItemsRepeater>
                </ScrollViewer>
            </ctk:Case>
        </ctk:SwitchPresenter>
    </Grid>
</Page>
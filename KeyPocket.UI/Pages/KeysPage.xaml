<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                HorizontalAlignment="Left"
                PlaceholderText="Search keys (provider, tag)..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="300"
                x:Uid="Keys_SearchBox" />

            <!--  Filters & Sort  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Sort by:"
                    VerticalAlignment="Center"
                    x:Uid="Keys_SortBy" />
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                    Width="140" />
            </StackPanel>

            <ToggleButton
                Grid.Column="2"
                IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                Margin="0,0,0,6"
                VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE735;" />
                    <TextBlock Text="Favorites" x:Uid="Keys_Favorites" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!--  Content  -->
        <GridView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.FilteredKeys, Mode=OneWay}"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyItemViewModel">
                    <Grid
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="170"
                        Padding="0"
                        Width="280">

                        <Grid Padding="16" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header: Provider Info + Favorite  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Opacity="0.7"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ProviderName}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--  Toggle Favorite Button  -->
                                <Grid Grid.Column="1">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        Padding="4"
                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource NegBoolToVis}}">
                                        <FontIcon FontSize="16" Glyph="&#xE734;" />
                                    </Button>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        Padding="4"
                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="#F2C811"
                                            Glyph="&#xE735;" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <!--  Key Display (Masked)  -->
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="14"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Text="{x:Bind DisplayKey, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="API Key (Masked)"
                                VerticalAlignment="Center"
                                x:Uid="Keys_MaskedKey" />

                            <!--  Footer: Tag & Copy  -->
                            <Grid ColumnSpacing="8" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    FontSize="12"
                                    Padding="8,4"
                                    PlaceholderText="Tag"
                                    Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    x:Uid="Keys_Tag" />

                                <controls:CopyButton
                                    Click="CopyButton_Click"
                                    Content="&#xE8C8;"
                                    Grid.Column="1"
                                    Padding="6"
                                    Tag="{x:Bind Id, Mode=OneWay}"
                                    ToolTipService.ToolTip="Copy Key"
                                    x:Uid="Keys_CopyKey" />
                            </Grid>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                HorizontalAlignment="Left"
                PlaceholderText="Search keys (provider, tag)..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="300" />

            <!--  Filters & Sort  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Sort by:"
                    VerticalAlignment="Center" />
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                    Width="140" />
            </StackPanel>

            <ToggleButton
                Grid.Column="2"
                IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                Margin="0,0,0,6"
                VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE735;" />
                    <TextBlock Text="Favorites" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!--  Content  -->
        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.FilteredKeys, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyItemViewModel">
                    <Grid Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Provider  -->
                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ProviderName}"
                            VerticalAlignment="Center" />

                        <!--  Key  -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontFamily="Consolas"
                                Text="{x:Bind DisplayKey, Mode=OneWay}"
                                VerticalAlignment="Center" />

                            <!--  Reveal Toggle  -->
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind RevealKeyCommand}"
                                Padding="4"
                                ToolTipService.ToolTip="Toggle Visibility">
                                <FontIcon FontSize="12" Glyph="{x:Bind IsKeyRevealed, Mode=OneWay, Converter={StaticResource BoolToGlyphConverter}, ConverterParameter='Reveal'}" />
                                <!--  Note: Simply using text or standard icon logic since converter might not exist for glyph switching directly without parameter logic. using simple logic below:  -->
                            </Button>
                        </StackPanel>

                        <!--  Tag  -->
                        <TextBox
                            Grid.Column="2"
                            Margin="0,0,16,0"
                            PlaceholderText="Tag"
                            Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                            VerticalAlignment="Center" />

                        <!--  Actions  -->
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ToggleFavoriteCommand}"
                                Padding="4"
                                ToolTipService.ToolTip="Favorite">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteColorConverter}}"
                                    Glyph="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource FavoriteIconConverter}}" />
                            </Button>

                            <controls:CopyButton
                                Click="CopyButton_Click"
                                Content="&#xE8C8;"
                                Padding="6"
                                Tag="{x:Bind Id, Mode=OneWay}"
                                ToolTipService.ToolTip="Copy Key" />

                            <!--  Delete Button (Simulated or add to ViewModel if missing)  -->
                            <!--  Assuming only favorite toggle and copy are current primary actions in row  -->
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
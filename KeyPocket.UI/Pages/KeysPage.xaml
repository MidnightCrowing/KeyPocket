<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:KeyPocket.UI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Controls/CopyButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                HorizontalAlignment="Left"
                PlaceholderText="Search keys (provider, tag)..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Width="300" />

            <!--  Filters & Sort  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,0,6"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Bottom">
                <TextBlock
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Sort by:"
                    VerticalAlignment="Center" />
                <ComboBox
                    ItemsSource="{x:Bind ViewModel.SortOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                    Width="140" />
            </StackPanel>

            <ToggleButton
                Grid.Column="2"
                IsChecked="{x:Bind ViewModel.ShowFavoritesOnly, Mode=TwoWay}"
                Margin="0,0,0,6"
                VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE735;" />
                    <TextBlock Text="Favorites" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!--  Content  -->
        <GridView
            Grid.Row="1"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.FilteredKeys, Mode=OneWay}"
            SelectionMode="None">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyItemViewModel">
                    <Grid
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="180"
                        Padding="0"
                        Width="320">

                        <Grid Padding="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header: Provider Info + Favorite  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Opacity="0.7"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ProviderName}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />

                                <!--  Favorite  -->
                                <Grid Grid.Column="1">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        Padding="4"
                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource NegBoolToVis}}">
                                        <FontIcon FontSize="16" Glyph="&#xE734;" />
                                    </Button>
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        Padding="4"
                                        Visibility="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon
                                            FontSize="16"
                                            Foreground="#F2C811"
                                            Glyph="&#xE735;" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <!--  Key Content  -->
                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    Text="{x:Bind DisplayKey, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!--  Actions & Metadata  -->
                            <Grid ColumnSpacing="8" Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  Tag with horizontal layout  -->
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Opacity="0.6"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="Tag:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="12"
                                        MinWidth="100"
                                        Opacity="0.8"
                                        PlaceholderText="Add tag..."
                                        Text="{x:Bind Tag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--  Icons  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <!--  Reveal  -->
                                    <Grid>
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind RevealKeyCommand}"
                                            Padding="6"
                                            ToolTipService.ToolTip="Show Key"
                                            Visibility="{x:Bind IsKeyRevealed, Mode=OneWay, Converter={StaticResource NegBoolToVis}}">
                                            <FontIcon FontSize="14" Glyph="&#xE890;" />
                                        </Button>
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind RevealKeyCommand}"
                                            Padding="6"
                                            ToolTipService.ToolTip="Hide Key"
                                            Visibility="{x:Bind IsKeyRevealed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                            <FontIcon FontSize="14" Glyph="&#xE891;" />
                                        </Button>
                                    </Grid>

                                    <!--  Copy  -->
                                    <controls:CopyButton
                                        Click="CopyButton_Click"
                                        Content="&#xE8C8;"
                                        Padding="6"
                                        Tag="{x:Bind Id, Mode=OneWay}"
                                        ToolTipService.ToolTip="Copy Key" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!--  Created Date Footer (Optional, maybe overlap bottom right)  -->
                        <TextBlock
                            FontSize="10"
                            HorizontalAlignment="Right"
                            IsHitTestVisible="False"
                            Margin="0,0,8,4"
                            Opacity="0.4"
                            Text="{x:Bind CreatedAtFormatted}"
                            VerticalAlignment="Bottom" />

                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

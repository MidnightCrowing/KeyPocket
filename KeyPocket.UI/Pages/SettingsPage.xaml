<Page
    x:Name="RootPage"
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:global="using:Windows.Globalization.NumberFormatting"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
        <converters:BoolNegationConverter x:Key="BoolNegation" />
        <global:DecimalFormatter x:Key="RateFormatter" FractionDigits="2" IntegerDigits="1" />
        <converters:DecimalToDoubleConverter x:Key="DecimalToDouble" />
        
        <!--  Spacing between cards  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock"
            x:Key="SettingsSectionHeaderTextBlockStyle">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollView
        Padding="36,0,36,0"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Border>
            <StackPanel MaxWidth="1064" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Margin="1,24,36,0"
                    MaxWidth="1064"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Appearance" />
                <toolkit:SettingsCard Description="Select which app theme to display" Header="App theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        AutomationProperties.AutomationId="themeModeComboBox"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Use system setting" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <!-- Currency Exchange Section -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Exchange Rates" />
                
                <!-- 1. Display Currency Selection -->
                <toolkit:SettingsCard Description="Set default display currency" Header="Display Currency">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE1D0;" />
                    </toolkit:SettingsCard.HeaderIcon>

                    <Grid>
                        <!-- ... (same currency selection logic) ... -->
                        <!-- Normal Mode: Dropdown + Add Button -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsAddingCurrency, Mode=OneWay, Converter={StaticResource NegBoolToVis}}">
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                                SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}"
                                MinWidth="100" />
                            <Button Command="{x:Bind ViewModel.StartAddCurrencyCommand}" Padding="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.DeleteSelectedCurrencyCommand}" Padding="8" ToolTipService.ToolTip="Remove selected currency">
                                <FontIcon Glyph="&#xE738;" FontSize="14" />
                            </Button>
                        </StackPanel>

                        <!-- Adding Mode: Input + Confirm/Cancel -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsAddingCurrency, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBox 
                                PlaceholderText="Code (e.g. JPY)" 
                                Text="{x:Bind ViewModel.NewCurrencyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Width="100" 
                                MaxLength="4" 
                                CharacterCasing="Upper"/>
                            <TextBox 
                                PlaceholderText="Symbol (e.g. ¥)" 
                                Text="{x:Bind ViewModel.NewCurrencySymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Width="100" 
                                MaxLength="4"/>
                            <Button Command="{x:Bind ViewModel.ConfirmAddCurrencyCommand}" Padding="8" Style="{StaticResource AccentButtonStyle}">
                                <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.CancelAddCurrencyCommand}" Padding="8">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </toolkit:SettingsCard>

                <!-- 2. Exchange Rates Expander -->
                <toolkit:SettingsExpander
                    Description="Configure exchange rates between currencies"
                    Header="Exchange Rate Details">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE825;" />
                    </toolkit:SettingsExpander.HeaderIcon>

                    <toolkit:SettingsExpander.Items>
                        <!-- Existing Rates List (Using ItemsControl inside SettingsExpander.Items) -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExchangeRateItem">
                                    <toolkit:SettingsCard>
                                        <toolkit:SettingsCard.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="48,0,0,0">
                                                <TextBlock Text="{x:Bind Source}" FontWeight="SemiBold" />
                                                <FontIcon Glyph="&#xE72A;" FontSize="12" Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind Target}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </toolkit:SettingsCard.Header>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <NumberBox 
                                                Value="{x:Bind RateValue, Mode=TwoWay}" 
                                                NumberFormatter="{StaticResource RateFormatter}"
                                                SpinButtonPlacementMode="Inline"
                                                SmallChange="0.01" 
                                                LargeChange="1.0"
                                                Width="140" />
                                            <Button 
                                                Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteRateCommand}" 
                                                CommandParameter="{x:Bind}" 
                                                ToolTipService.ToolTip="Remove"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Width="32"
                                                Height="32"
                                                Padding="0">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Custom Rate Footer -->
                        <toolkit:SettingsCard IsClickEnabled="{x:Bind ViewModel.IsAddingRate, Converter={StaticResource BoolNegation}, Mode=OneWay}"
                                              Command="{x:Bind ViewModel.StartAddRateCommand}"
                                              IsActionIconVisible="False"
                                              HorizontalContentAlignment="Left">
                            <toolkit:SettingsCard.Resources>
                                <x:Double x:Key="SettingsCardWrapThreshold">10000</x:Double>
                            </toolkit:SettingsCard.Resources>
                            <Grid>
                                <!-- View Mode: "Add Exchange Rate" Label (Replaces Header) -->
                                <StackPanel Orientation="Horizontal" Spacing="8" 
                                            Visibility="{x:Bind ViewModel.IsAddingRate, Converter={StaticResource NegBoolToVis}, Mode=OneWay}"
                                            Padding="0,10">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Add Exchange Rate" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Edit Mode: Inputs -->
                                <StackPanel Orientation="Horizontal" Spacing="12" 
                                            Visibility="{x:Bind ViewModel.IsAddingRate, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                            HorizontalAlignment="Left">
                                    <ComboBox PlaceholderText="From" 
                                              ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                                              SelectedItem="{x:Bind ViewModel.NewRateSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              Width="100"/>
                                    <FontIcon Glyph="&#xE72A;" FontSize="12" VerticalAlignment="Center" Opacity="0.5"/>
                                    <ComboBox PlaceholderText="To" 
                                              ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                                              SelectedItem="{x:Bind ViewModel.NewRateTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                              Width="100"/>
                                    <TextBlock Text="=" VerticalAlignment="Center" Opacity="0.5" />
                                    <NumberBox PlaceholderText="Rate" Value="{x:Bind ViewModel.NewRateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                               NumberFormatter="{StaticResource RateFormatter}"
                                               SmallChange="0.01"
                                               SpinButtonPlacementMode="Inline"
                                               Width="160" />
                                    
                                    <Button Command="{x:Bind ViewModel.AddCustomRateCommand}" Style="{StaticResource AccentButtonStyle}" Padding="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                                    </Button>
                                    <Button Command="{x:Bind ViewModel.CancelAddRateCommand}" Padding="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </toolkit:SettingsCard>
                        
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>


                <!--  About  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="About" />
                <toolkit:SettingsExpander
                    Description="© 2026 MidnightCrowing."
                    Header="{StaticResource AppTitleName}"
                    Margin="0,0,0,36">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/KeyPocket.png" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Version}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            Command="{x:Bind ViewModel.OpenGitHubCommand}"
                            Header="GitHub"
                            IsClickEnabled="True">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            Command="{x:Bind ViewModel.OpenFeedbackCommand}"
                            Header="Open an issue or pull request"
                            IsClickEnabled="True">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

            </StackPanel>
        </Border>
    </ScrollView>
</Page>

<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!--  Spacing between cards  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock"
            x:Key="SettingsSectionHeaderTextBlockStyle">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollView
        Padding="36,0,36,0"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Border>
            <StackPanel MaxWidth="1064" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Margin="1,24,36,0"
                    MaxWidth="1064"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Appearance" />
                <toolkit:SettingsCard Description="Select which app theme to display" Header="App theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        AutomationProperties.AutomationId="themeModeComboBox"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                        <ComboBoxItem Content="Use system setting" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Currency" />
                <toolkit:SettingsCard Description="Select display currency and conversion rate" Header="Currency">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEAF3;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Spacing="8">
                        <ComboBox
                            AutomationProperties.AutomationId="currencyComboBox"
                            SelectedValue="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Tag="USD" Content="USD (美元)" />
                            <ComboBoxItem Tag="CNY" Content="CNY (人民币)" />
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Text="USD → CNY rate:" />
                            <NumberBox Value="{x:Bind ViewModel.UsdToCnyRate, Mode=TwoWay}" Minimum="0" Maximum="1000" SmallChange="0.01" Width="120" />
                            <Button x:Name="RefreshRateButton" Click="RefreshRateButton_Click" Command="{x:Bind ViewModel.RefreshExchangeRateCommand}" Content="Refresh" Style="{StaticResource DefaultButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!--  About  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="About" />
                <toolkit:SettingsExpander
                    Description="© 2026 MidnightCrowing."
                    Header="{StaticResource AppTitleName}"
                    Margin="0,0,0,36">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/KeyPocket.png" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Version}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            Command="{x:Bind ViewModel.OpenGitHubCommand}"
                            Header="GitHub"
                            IsClickEnabled="True">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>

                        <toolkit:SettingsCard
                            Command="{x:Bind ViewModel.OpenFeedbackCommand}"
                            Header="Open an issue or pull request"
                            IsClickEnabled="True">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

            </StackPanel>
        </Border>
    </ScrollView>
</Page>


<Page
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.SettingsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:global="using:Windows.Globalization.NumberFormatting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
        <converters:BoolNegationConverter x:Key="BoolNegation" />
        <global:DecimalFormatter
            FractionDigits="2"
            IntegerDigits="1"
            x:Key="RateFormatter" />

        <!--  Spacing between cards  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock"
            x:Key="SettingsSectionHeaderTextBlockStyle">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <DataTemplate x:DataType="vm:ExchangeRateItem" x:Key="RateTemplate">
            <ctk:SettingsCard IsClickEnabled="False">
                <ctk:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Source}" />
                        <FontIcon
                            FontSize="12"
                            Glyph="&#xE72A;"
                            Opacity="0.6" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Target}" />
                    </StackPanel>
                </ctk:SettingsCard.Header>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox
                        LargeChange="1.0"
                        NumberFormatter="{StaticResource RateFormatter}"
                        SmallChange="0.01"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind RateValue, Mode=TwoWay}"
                        Width="140" />
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ElementName=Root, Path=ViewModel.DeleteRateCommand}"
                        CommandParameter="{x:Bind}"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Remove"
                        Width="32">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </ctk:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="AddFooterTemplate">
            <!--  DataContext is AddRatePlaceholder, so we must bind to ElementName=RootPage ViewModel  -->
            <ctk:SettingsCard
                Command="{Binding ElementName=Root, Path=ViewModel.StartAddRateCommand}"
                HorizontalContentAlignment="Left"
                IsActionIconVisible="False"
                IsClickEnabled="{Binding ElementName=Root, Path=ViewModel.IsAddingRate, Converter={StaticResource BoolNegation}, Mode=OneWay}">
                <ctk:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardWrapThreshold">10000</x:Double>
                </ctk:SettingsCard.Resources>
                <Grid>
                    <!--  View Mode: "Add Exchange Rate" Label (Replaces Header)  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Padding="0,10"
                        Spacing="8"
                        Visibility="{Binding ElementName=Root, Path=ViewModel.IsAddingRate, Converter={StaticResource NegBoolToVis}, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="Add Exchange Rate"
                            VerticalAlignment="Center"
                            x:Uid="/Settings/AddExchangeRate" />
                    </StackPanel>

                    <!--  Edit Mode: Inputs  -->
                    <StackPanel
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{Binding ElementName=Root, Path=ViewModel.IsAddingRate, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                        <ComboBox
                            ItemsSource="{Binding ElementName=Root, Path=ViewModel.AvailableCurrencies}"
                            PlaceholderText="From"
                            SelectedItem="{Binding ElementName=Root, Path=ViewModel.NewRateSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="100"
                            x:Uid="/Settings/AddRate_From" />
                        <FontIcon
                            FontSize="12"
                            Glyph="&#xE72A;"
                            Opacity="0.5"
                            VerticalAlignment="Center" />
                        <ComboBox
                            ItemsSource="{Binding ElementName=Root, Path=ViewModel.AvailableCurrencies}"
                            PlaceholderText="To"
                            SelectedItem="{Binding ElementName=Root, Path=ViewModel.NewRateTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="100"
                            x:Uid="/Settings/AddRate_To" />
                        <TextBlock
                            Opacity="0.5"
                            Text="="
                            VerticalAlignment="Center" />
                        <NumberBox
                            NumberFormatter="{StaticResource RateFormatter}"
                            PlaceholderText="Rate"
                            SmallChange="0.01"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding ElementName=Root, Path=ViewModel.NewRateValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Width="160"
                            x:Uid="/Settings/AddRate_Rate" />

                        <Button
                            Command="{Binding ElementName=Root, Path=ViewModel.AddCustomRateCommand}"
                            Padding="8"
                            Style="{StaticResource AccentButtonStyle}">
                            <FontIcon FontSize="14" Glyph="&#xE73E;" />
                        </Button>
                        <Button Command="{Binding ElementName=Root, Path=ViewModel.CancelAddRateCommand}" Padding="8">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </ctk:SettingsCard>
        </DataTemplate>

    </Page.Resources>

    <ScrollView
        Padding="36,0,36,0"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Border>
            <StackPanel MaxWidth="1064" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Margin="1,24,36,0"
                    MaxWidth="1064"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings"
                    x:Uid="/Settings/Title" />

                <!--  Appearance  -->
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Appearance"
                    x:Uid="/Settings/Appearance" />

                <ctk:SettingsCard
                    Description="Select which app theme to display"
                    Header="App theme"
                    x:Uid="/Settings/Theme">
                    <ctk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </ctk:SettingsCard.HeaderIcon>
                    <ComboBox AutomationProperties.AutomationId="themeModeComboBox" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Light" x:Uid="/Settings/Theme_Light" />
                        <ComboBoxItem Content="Dark" x:Uid="/Settings/Theme_Dark" />
                        <ComboBoxItem Content="Use system setting" x:Uid="/Settings/Theme_System" />
                    </ComboBox>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Description="Select window material"
                    Header="Window material"
                    x:Uid="/Settings/Backdrop">
                    <ctk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </ctk:SettingsCard.HeaderIcon>
                    <ComboBox SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Mica" x:Uid="/Settings/Backdrop_Mica" />
                        <ComboBoxItem Content="Mica Alt" x:Uid="/Settings/Backdrop_MicaAlt" />
                        <ComboBoxItem Content="Acrylic" x:Uid="/Settings/Backdrop_Acrylic" />
                        <ComboBoxItem Content="None" x:Uid="/Settings/Backdrop_None" />
                    </ComboBox>
                </ctk:SettingsCard>

                <ctk:SettingsCard
                    Description="Select application language"
                    Header="Language"
                    x:Uid="/Settings/Language">
                    <ctk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE775;" />
                    </ctk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowRestartWarning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            x:Uid="/Settings/RestartRequired" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Use system setting" x:Uid="/Settings/Language_Auto" />
                            <ComboBoxItem Content="English" x:Uid="/Settings/Language_En" />
                            <ComboBoxItem Content="Simplified Chinese" x:Uid="/Settings/Language_Zh" />
                            <ComboBoxItem Content="Traditional Chinese" x:Uid="/Settings/Language_ZhTw" />
                        </ComboBox>
                    </StackPanel>
                </ctk:SettingsCard>

                <!--  Currency Exchange Section  -->
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Exchange Rates"
                    x:Uid="/Settings/ExchangeRates" />

                <!--  1. Display Currency Selection  -->
                <ctk:SettingsCard
                    Description="Set default display currency"
                    Header="Display Currency"
                    x:Uid="/Settings/DisplayCurrency">
                    <ctk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE1D0;" />
                    </ctk:SettingsCard.HeaderIcon>

                    <Grid>
                        <!--  ... (same currency selection logic) ...  -->
                        <!--  Normal Mode: Dropdown + Add Button  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsAddingCurrency, Mode=OneWay, Converter={StaticResource NegBoolToVis}}">
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                                MinWidth="100"
                                SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}" />
                            <Button Command="{x:Bind ViewModel.StartAddCurrencyCommand}" Padding="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.DeleteSelectedCurrencyCommand}"
                                Padding="8"
                                ToolTipService.ToolTip="Remove selected currency">
                                <FontIcon FontSize="14" Glyph="&#xE738;" />
                            </Button>
                        </StackPanel>

                        <!--  Adding Mode: Input + Confirm/Cancel  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsAddingCurrency, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBox
                                CharacterCasing="Upper"
                                MaxLength="4"
                                PlaceholderText="Code (e.g. JPY)"
                                Text="{x:Bind ViewModel.NewCurrencyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="100" />
                            <TextBox
                                MaxLength="4"
                                PlaceholderText="Symbol (e.g. ¥)"
                                Text="{x:Bind ViewModel.NewCurrencySymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="100" />
                            <Button
                                Command="{x:Bind ViewModel.ConfirmAddCurrencyCommand}"
                                Padding="8"
                                Style="{StaticResource AccentButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE73E;" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.CancelAddCurrencyCommand}" Padding="8">
                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </ctk:SettingsCard>

                <!--  2. Exchange Rates Expander  -->
                <ctk:SettingsExpander
                    Description="Configure exchange rates between currencies"
                    Header="Exchange Rate Details"
                    IsExpanded="False"
                    x:Name="RatesExpander"
                    x:Uid="/Settings/ExchangeRateDetails">
                    <ctk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE825;" />
                    </ctk:SettingsExpander.HeaderIcon>
                </ctk:SettingsExpander>

                <!--  About  -->
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="About"
                    x:Uid="/Settings/About" />
                <ctk:SettingsExpander
                    Description="© 2026 KeyPocket Community."
                    Header="{StaticResource AppTitleName}"
                    Margin="0,0,0,36"
                    x:Uid="/Settings/AboutExpander">
                    <ctk:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/KeyPocket.png" />
                    </ctk:SettingsExpander.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Version}" />
                    <ctk:SettingsExpander.Items>
                        <!--  GitHub  -->
                        <ctk:SettingsCard
                            Command="{x:Bind ViewModel.OpenGitHubCommand}"
                            Header="GitHub"
                            IsClickEnabled="True"
                            x:Uid="/Settings/GitHub">
                            <ctk:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </ctk:SettingsCard.ActionIcon>
                        </ctk:SettingsCard>

                        <!--  Open an issue or pull request  -->
                        <ctk:SettingsCard
                            Command="{x:Bind ViewModel.OpenFeedbackCommand}"
                            Header="Open an issue or pull request"
                            IsClickEnabled="True"
                            x:Uid="/Settings/Issue">
                            <ctk:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </ctk:SettingsCard.ActionIcon>
                        </ctk:SettingsCard>

                        <!--  Resources & Sources  -->
                        <ctk:SettingsCard
                            ContentAlignment="Vertical"
                            Header="Resources &amp; Sources"
                            HorizontalContentAlignment="Left"
                            x:Uid="/Settings/Resources">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton
                                    Content="AI &#47; LLM Model Icon"
                                    NavigateUri="https://lobehub.com/icons"
                                    x:Uid="/Settings/IconLink" />
                            </StackPanel>
                        </ctk:SettingsCard>

                        <!--  License  -->
                        <ctk:SettingsCard
                            ContentAlignment="Vertical"
                            Header="License"
                            HorizontalContentAlignment="Left"
                            x:Uid="/Settings/License">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton Content="MIT License" NavigateUri="https://github.com/MidnightCrowing/KeyPocket/blob/main/LICENSE" />
                            </StackPanel>
                        </ctk:SettingsCard>
                    </ctk:SettingsExpander.Items>
                </ctk:SettingsExpander>

            </StackPanel>
        </Border>
    </ScrollView>
</Page>

<Page
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.SettingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="using:KeyPocket.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:global="using:Windows.Globalization.NumberFormatting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:KeyPocket.UI.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NegatedBoolToVisibilityConverter x:Key="NegBoolToVis" />
        <global:DecimalFormatter
            FractionDigits="2"
            IntegerDigits="1"
            x:Key="RateFormatter" />

        <!--  Spacing between cards  -->
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock"
            x:Key="SettingsSectionHeaderTextBlockStyle">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <DataTemplate x:DataType="vm:ExchangeRateItem" x:Key="RateTemplate">
            <toolkit:SettingsCard IsClickEnabled="False">
                <toolkit:SettingsCard.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Source}" />
                        <FontIcon
                            FontSize="12"
                            Glyph="&#xE72A;"
                            Opacity="0.6" />
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Target}" />
                    </StackPanel>
                </toolkit:SettingsCard.Header>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox
                        LargeChange="1.0"
                        NumberFormatter="{StaticResource RateFormatter}"
                        SmallChange="0.01"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind RateValue, Mode=TwoWay}"
                        Width="140" />
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ElementName=RootPage, Path=ViewModel.DeleteRateCommand}"
                        CommandParameter="{x:Bind}"
                        Height="32"
                        Padding="0"
                        ToolTipService.ToolTip="Remove"
                        Width="32">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xE74D;" />
                    </Button>
                </StackPanel>
            </toolkit:SettingsCard>
        </DataTemplate>

    </Page.Resources>

    <ScrollView
        Padding="36,0,36,0"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <Border>
            <StackPanel MaxWidth="1064" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition />
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Margin="1,24,36,0"
                    MaxWidth="1064"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings"
                    x:Uid="Settings_Title" />

                <!--  Appearance  -->
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Appearance"
                    x:Uid="Settings_Appearance" />

                <toolkit:SettingsCard
                    Description="Select which app theme to display"
                    Header="App theme"
                    x:Uid="Settings_Theme">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox AutomationProperties.AutomationId="themeModeComboBox" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Light" x:Uid="Settings_Theme_Light" />
                        <ComboBoxItem Content="Dark" x:Uid="Settings_Theme_Dark" />
                        <ComboBoxItem Content="Use system setting" x:Uid="Settings_Theme_System" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Description="Select application language"
                    Header="Language"
                    x:Uid="Settings_Language">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE775;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowRestartWarning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            x:Uid="Settings_RestartRequired" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Use system setting" x:Uid="Settings_Language_Auto" />
                            <ComboBoxItem Content="English" x:Uid="Settings_Language_En" />
                            <ComboBoxItem Content="Simplified Chinese" x:Uid="Settings_Language_Zh" />
                            <ComboBoxItem Content="Traditional Chinese" x:Uid="Settings_Language_ZhTw" />
                        </ComboBox>
                    </StackPanel>
                </toolkit:SettingsCard>

                <!--  Currency Exchange Section  -->
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Exchange Rates"
                    x:Uid="Settings_ExchangeRates" />

                <!--  1. Display Currency Selection  -->
                <toolkit:SettingsCard
                    Description="Set default display currency"
                    Header="Display Currency"
                    x:Uid="Settings_DisplayCurrency">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE1D0;" />
                    </toolkit:SettingsCard.HeaderIcon>

                    <Grid>
                        <!--  ... (same currency selection logic) ...  -->
                        <!--  Normal Mode: Dropdown + Add Button  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsAddingCurrency, Mode=OneWay, Converter={StaticResource NegBoolToVis}}">
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                                MinWidth="100"
                                SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}" />
                            <Button Command="{x:Bind ViewModel.StartAddCurrencyCommand}" Padding="8">
                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.DeleteSelectedCurrencyCommand}"
                                Padding="8"
                                ToolTipService.ToolTip="Remove selected currency">
                                <FontIcon FontSize="14" Glyph="&#xE738;" />
                            </Button>
                        </StackPanel>

                        <!--  Adding Mode: Input + Confirm/Cancel  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsAddingCurrency, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBox
                                CharacterCasing="Upper"
                                MaxLength="4"
                                PlaceholderText="Code (e.g. JPY)"
                                Text="{x:Bind ViewModel.NewCurrencyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="100" />
                            <TextBox
                                MaxLength="4"
                                PlaceholderText="Symbol (e.g. ¥)"
                                Text="{x:Bind ViewModel.NewCurrencySymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="100" />
                            <Button
                                Command="{x:Bind ViewModel.ConfirmAddCurrencyCommand}"
                                Padding="8"
                                Style="{StaticResource AccentButtonStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE73E;" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.CancelAddCurrencyCommand}" Padding="8">
                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </toolkit:SettingsCard>

                <!--  2. Exchange Rates Expander  -->
                <toolkit:SettingsExpander
                    Description="Configure exchange rates between currencies"
                    Header="Exchange Rate Details"
                    IsExpanded="False"
                    x:Name="RatesExpander"
                    x:Uid="Settings_ExchangeRateDetails">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE825;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                </toolkit:SettingsExpander>

                <!--  About  -->
                <TextBlock
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="About"
                    x:Uid="Settings_About" />
                <toolkit:SettingsExpander
                    Description="© 2026 MidnightCrowing."
                    Header="{StaticResource AppTitleName}"
                    Margin="0,0,0,36"
                    x:Uid="Settings_AboutExpander">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/KeyPocket.png" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.Version}" />
                    <toolkit:SettingsExpander.Items>
                        <!--  GitHub  -->
                        <toolkit:SettingsCard
                            Command="{x:Bind ViewModel.OpenGitHubCommand}"
                            Header="GitHub"
                            IsClickEnabled="True"
                            x:Uid="Settings_GitHub">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>

                        <!--  Open an issue or pull request  -->
                        <toolkit:SettingsCard
                            Command="{x:Bind ViewModel.OpenFeedbackCommand}"
                            Header="Open an issue or pull request"
                            IsClickEnabled="True"
                            x:Uid="Settings_Issue">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>

                        <!--  Resources & Sources  -->
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            Header="Resources &amp; Sources"
                            HorizontalContentAlignment="Left"
                            x:Uid="Settings_Resources">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton
                                    Content="AI &#47; LLM Model Icon"
                                    NavigateUri="https://lobehub.com/icons"
                                    x:Uid="Settings_IconLink" />
                            </StackPanel>
                        </toolkit:SettingsCard>

                        <!--  License  -->
                        <toolkit:SettingsCard
                            ContentAlignment="Vertical"
                            Header="License"
                            HorizontalContentAlignment="Left"
                            x:Uid="Settings_License">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton Content="MIT License" NavigateUri="https://github.com/MidnightCrowing/KeyPocket/blob/main/LICENSE" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

            </StackPanel>
        </Border>
    </ScrollView>
</Page>
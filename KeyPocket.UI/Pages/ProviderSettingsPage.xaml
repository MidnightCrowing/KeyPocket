<Page
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d"
    x:Class="KeyPocket.UI.Pages.ProviderSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="using:KeyPocket.UI.Pages.ProviderSettings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <ResourceDictionary />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            ViewChanged="OnScrollViewChanged"
            x:Name="MainScrollViewer">
            <StackPanel Padding="40,32" Spacing="0">

                <!--  Page Header  -->
                <TextBlock
                    Margin="0,0,0,24"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.Name, Mode=OneWay}" />

                <Border
                    Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Height="1"
                    Margin="0,0,0,32" />

                <!--  General Settings Section  -->
                <Grid ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" x:Name="GeneralHeader">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="General"
                            x:Uid="/ProviderSettings/General" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Basic provider information."
                            x:Uid="/ProviderSettings/GeneralDesc" />
                    </StackPanel>

                    <sections:ProviderSettingsGeneralContent
                        Grid.Column="1"
                        ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                        x:Name="GeneralSection" />
                </Grid>

                <Border
                    Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Height="1"
                    Margin="0,40,0,40" />

                <!--  API Keys Section  -->
                <Grid ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" x:Name="ApiKeysHeader">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="API Keys"
                                VerticalAlignment="Center"
                                x:Uid="/ProviderSettings/ApiKeys" />
                            <InfoBadge Value="{x:Bind ViewModel.ApiKeys.Count, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Manage access keys for this provider."
                            x:Uid="/ProviderSettings/ApiKeysDesc" />
                    </StackPanel>

                    <sections:ProviderSettingsApiKeysContent
                        Grid.Column="1"
                        ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                        x:Name="ApiKeysSection" />
                </Grid>

                <Border
                    Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Height="1"
                    Margin="0,40,0,40" />

                <!--  Models Section  -->
                <Grid ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4" x:Name="ModelsHeader">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="Models"
                                VerticalAlignment="Center"
                                x:Uid="/ProviderSettings/Models" />
                            <InfoBadge Value="{x:Bind ViewModel.Models.Count, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Configure available models."
                            x:Uid="/ProviderSettings/ModelsDesc" />
                    </StackPanel>

                    <sections:ProviderSettingsModelsContent
                        Grid.Column="1"
                        ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                        x:Name="ModelsSection" />
                </Grid>

                <Border
                    Background="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    Height="1"
                    Margin="0,40,0,40" />

                <StackPanel Margin="0,0,0,40" Spacing="16">
                    <Border
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="Delete this provider"
                                    x:Uid="/ProviderSettings/DeleteProvider" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Once you delete a provider, there is no going back. Please be certain."
                                    x:Uid="/ProviderSettings/DeleteProviderDesc" />
                            </StackPanel>

                            <Button
                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                BorderThickness="0"
                                Click="OnDeleteProviderClicked"
                                Content="Delete this provider"
                                Foreground="White"
                                Grid.Column="1"
                                x:Uid="/ProviderSettings/DeleteProviderButton" />
                        </Grid>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  Sticky Headers Canvas Overlay  -->
        <Canvas
            Grid.Row="0"
            IsHitTestVisible="False"
            VerticalAlignment="Top"
            x:Name="StickyHeadersCanvas">
            <!--  Sticky headers will be added here dynamically or via templates  -->
        </Canvas>

        <Border
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Grid.Row="1"
            Padding="16,12"
            VerticalAlignment="Bottom">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="OnSaveAllClicked"
                    Content="Save Changes"
                    Grid.Column="1"
                    Style="{StaticResource AccentButtonStyle}"
                    x:Uid="/ProviderSettings/Save" />
            </Grid>
        </Border>
    </Grid>
</Page>
